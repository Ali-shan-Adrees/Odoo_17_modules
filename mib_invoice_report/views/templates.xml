<?xml version="1.0"?>
<odoo>
    <data>
        <record id="mib_invoice_report_pap" model="report.paperformat">
            <field name="name">MIB Invoice order report</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">37</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">35</field>
            <field name="dpi">90</field>
        </record>
        <!-- <report 
            id="mib_sale_order_report_ext"
            model="account.move"
            name="mib_invoice_report.mib_invoice_report"
            file="mib_invoice_report.mib_invoice_report"
            report_type="qweb-pdf"
            string="Invoice MIB "
            print_report_name="(object._get_report_base_filename())" 
            paperformat="mib_invoice_report_pap" /> -->


        <record id="mib_sale_order_report_ext" model="ir.actions.report">
            <field name="name">MIB Invoice order report</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">mib_invoice_report.mib_invoice_report</field>
            <field name="report_file">mib_invoice_report.mib_invoice_report</field>
           <field name="print_report_name">'Invoice MIB - %s' %(object.name)</field>
            <field name="binding_model_id" ref="account.model_account_move" />
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="mib_invoice_report_pap" />
        </record>
    </data>
</odoo>