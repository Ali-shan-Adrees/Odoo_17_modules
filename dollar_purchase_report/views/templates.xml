<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="dollar_purchase_report_format_ext" model="report.paperformat">
		<field name="name">Dollar Purchase Report</field>
		<field name="default" eval="True"/>
		<field name="format">custom</field>
		<field name="page_height">170</field>
		<field name="page_width">100</field>
		<field name="orientation">Portrait</field>
		<field name="margin_top">0</field>
		<field name="margin_bottom">0</field>       
		<field name="margin_left">1</field>
		<field name="margin_right">1</field>
		<field name="header_line" eval="False"/>
		<field name="header_spacing">0</field>
		<field name="dpi">90</field>
	</record>
	
	<record id="dollar_purchase_report_ext" model="ir.actions.report">
			<field name="name">Print Receipt</field>
			<field name="model">dollar.purchase</field>
			<field name="report_type">qweb-pdf</field>
			<field name="report_name">dollar_purchase_report.dollar_purchase_report</field>
			<field name="report_file">dollar_purchase_report.dollar_purchase_report</field>
			<field name="print_report_name">'Print Receipt- %s' %(object.name)</field>
			<field name="binding_model_id" ref="dollar_purchase.model_dollar_purchase" />
			<field name="binding_type">report</field>
			<field name="paperformat_id" ref="dollar_purchase_report_format_ext" />
		</record>

</odoo>