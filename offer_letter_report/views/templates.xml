<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="offer_letter_report_format" model="report.paperformat">
		<field name="name">Offer Letter</field>
		<field name="default" eval="True" />
		<field name="format">A4</field>
		<field name="orientation">Portrait</field>
		<field name="margin_top">0</field>
		<field name="margin_bottom">25</field>
		<field name="margin_left">5</field>
		<field name="margin_right">5</field>
		<field name="header_line" eval="True" />
		<field name="header_spacing">0</field>
		<field name="dpi">0</field>
	</record>
	<record id="offer_letter_report_ext" model="ir.actions.report">
		<field name="name">Offer Letter Report</field>
		<field name="model">hr.offer.letter</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">offer_letter_report.offer_letter_report</field>
		<field name="report_file">offer_letter_report.offer_letter_report</field>
		<field name="print_report_name">'Offer Letter - %s' % (object.applicant_id.name)</field>
		<field name="paperformat_id" ref="offer_letter_report_format" />
		<field name="binding_type">report</field>
	</record>
</odoo>