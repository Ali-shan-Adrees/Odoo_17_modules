<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="boc_quotation_report">
            <t t-call="web.html_container">
                <t t-call="boc_quotation_report.boc_quotation_external_layout">
                    <t t-foreach="docs" t-as="o">
                        <t t-set="o" t-value="o.sudo()"></t>
                        <div class="page">
                            <style>
                            .main_wraper {
                                width: 100%;
                            }

                            .main_div {
                                width: 100%;
                                margin-bottom: 5px;
                            }

                            .left_div {
                                float: left;
                                width: 50%;
                                font-size: 13px;
                            }

                            .right_div {
                                width: 50%;
                                float: left;
                                font-size: 13px;
                            }

                            .left_div_1 {
                                height: 130px;
                                float: left;
                                width: 49.5%;
                                font-size: 13px;
                                overflow: hidden;
                            }

                            .right_div_1 {
                                height: 130px;
                                width: 50%;
                                float: right;
                                font-size: 13px;
                                overflow: hidden;
                            }

                            .right_div_1 table,
                            .left_div_1 table {
                                height: 130px;
                                border-bottom: none;
                            }

                            .right_div_2 {
                                width: 33%;
                                float: left;
                                font-size: 13px;
                            }

                            .clear_float {
                                clear: both;
                                float: none;
                                height: 0px;
                                width: 0px;
                                display: block;
                            }

                            .left_div_n,
                            .center_div_n,
                            .right_div_n {
                                float: left;
                                font-size: 13px;
                                box-sizing: border-box;
                            }

                            .main_div_n {
                                width: 100%;

                            }

                            .left_div_n {
                                width: 30%;
                            }

                            .center_div_n {
                                width: 50%;
                                text-align: center;
                            }

                            .right_div_n {
                                width: 20%;
                            }


                            .main_div_a {
                                width: 100%;


                            }

                            .left_div_a {
                                float: left;
                                width: 90%;
                            }

                            .right_div_a {
                                float: left;
                                width: 10%;
                            }

                            .table-container {
                                display: flex;
                                gap: 3px;
                            }

                            .box-table {
                                border: 1px solid black;
                                border-collapse: collapse;
                                width: 100%;
                            }

                            .box-table td {
                                padding: 0;
                            }


                            .box-table_div {
                                width: 100%;
                                border: 1px solid black;
                                border-collapse: collapse;
                            }

                            .box-table_div td {
                                padding: 10px;
                            }

                            .left-div {
                                width: 50%;
                                border-right: 1px solid black;
                            }

                            .right-div {
                                width: 50%;
                            }

                            .box-table_div td div {
                                margin-bottom: 5px;
                            }

                            .table {
                                border: 1px solid black;
                                border-collapse: collapse;
                            }

                            .table th {
                                padding: 2px 5px !important;
                                text-align: center !important;
                                font-size: 13px;
                            }

                            .table td {
                                padding: 2px 5px !important;
                                font-size: 13px;
                            }

                            .left-column {
                                width: 50%;
                                border-right: 1px solid black;
                            }

                            .right-column {
                                width: 50%;
                            }

                            .box-table-new {
                                width: 100%;
                                border: 1px solid black;
                                border-collapse: collapse;
                            }

                            .box-table-new td {
                                padding: 23px;
                            }

                            .box-table-new td div {
                                margin-bottom: 5px;
                            }

                            .footer {
                                width: 100%;
                                text-align: center;
                                font-size: 10px;
                                border-top: 1px solid #ddd;
                            }
                            </style>
                            <div class="main_wraper">
                                <br style="clear:both; float:none;border:none; width:0;height:0;" />
                                <div class="main_div_n">
                                </div>
                                <div class="left_div_n">
                                    <!-- 12175 -->
                                    <span t-esc="o.partner_id.customer_rank" />
                                </div>
                                <div class="center_div_n">
                                    <strong style="font-size: 16px;">1020992GST501</strong>
                                </div>
                                <div class="right_div_n" style="border: 1px solid black; padding-left: 1px; text-align: center; margin-bottom: 5px;">
                                    <strong style="font-size: 18px;">
                                        <t t-if="o.state == 'draft'">QUOTATION</t>
                                        <t t-if="o.state == 'sent'">QUOTATION SENT</t>
                                        <t t-if="o.state == 'sale'">SALES ORDER</t>
                                    </strong>
                                </div>
                                <br style="clear:both; float:none;border:none; width:0;height:0;" />
                                <div class="main_div">
                                    <div class="left_div_1">
                                        <table class="box-table">
                                            <tr>
                                                <td style="padding-left :2px;">
                                                    <span t-esc="o.partner_id.name" /><br />
                                                    <span t-esc="o.partner_id.street" />
                                                    <span t-esc="o.partner_id.street2" />
                                                    <span t-esc="o.partner_id.state_id.name" />
                                                    <span t-esc="o.partner_id.zip" />
                                                    <span t-esc="o.partner_id.country_id.name" />
                                                    TIN:<span t-esc="o.partner_id.vat" />
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="right_div_1">
                                        <table class="box-table-new">
                                            <tr>
                                                <td class="left-column">
                                                    <div><strong>Purchase Order:</strong>
                                                        <!-- Related Purchase Orders -->
                                                        <t t-if="o.order_line">
                                                            <div style="margin-top:10px;">
                                                                <t t-foreach="o.order_line.mapped('purchase_line_ids.order_id')" t-as="po">
                                                                    <span>
                                                                        <t t-esc="po.name" /></span><br />
                                                                </t>
                                                            </div>
                                                        </t>
                                                    </div>
                                                    <div><strong>Delivery Order Ref:</strong>
                                                        <t t-if="o.picking_ids">
                                                            <t t-foreach="o.picking_ids" t-as="picking">
                                                                <span>
                                                                    <t t-esc="picking.name" /></span><br />
                                                            </t>
                                                        </t>
                                                    </div>
                                                    <div><strong>Terms:</strong>
                                                        <span t-esc="o.payment_term_id.name" />
                                                    </div>
                                                </td>
                                                <td class="right-column">
                                                    <div><strong>Date:</strong>
                                                        <span t-esc="o.date_order">
                                                        </span>
                                                    </div>
                                                    <div />
                                                    <div><strong>Invoice No:</strong>
                                                        <t t-if="o.invoice_ids">
                                                            <t t-foreach="o.invoice_ids" t-as="inv">
                                                                <span>
                                                                    <t t-esc="inv.name" /></span><br />
                                                            </t>
                                                        </t>
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <br />
                                <div>
                                    <table class="m-0 table" width="100%">
                                        <thead>
                                            <tr style="border: 1px solid black; border-bottom : none !important;">
                                                <th style="text-align:left; ">
                                                    Item Number
                                                </th>
                                                <th style="text-align:left;width:40%;">
                                                    Description
                                                </th>
                                                <th style="text-align:left;">
                                                    UOM
                                                </th>
                                                <th style="text-align:left; ">Qty</th>
                                                <th style="text-align:left; ">Unit Price</th>
                                                <th style="text-align:left; ">Net amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="total_lines" t-value="len(o.order_line)" />
                                            <t t-foreach="enumerate(o.order_line, 1)" t-as="pair">
                                                <!-- pair[0] = index (1-based), pair[1] = line -->
                                                <t t-set="idx" t-value="pair[0]" />
                                                <t t-set="line" t-value="pair[1]" />
                                                <t t-set="usd_line" t-value="line_converted_values[o.id][line.id]" />
                                                <tr style="border: none !important;">
                                                    <td style="border: none !important; text-align:right;">
                                                        <span t-esc="line.product_template_id.default_code" />
                                                    </td>
                                                    <td style="border: none !important;">
                                                        <span t-esc="line.name.replace('[%s] ' % line.product_id.default_code if line.product_id.default_code else '', '')"/>
                                                    </td>
                                                    <td style="border: none !important; text-align:center;">
                                                        <span t-esc="line.product_uom.name" />
                                                    </td>
                                                    <td style="border: none !important; text-align:right;">
                                                        <!-- <span t-esc="line.product_uom_qty" /> -->
                                                        <span t-esc="'{0:,.2f}'.format(float(line.product_uom_qty))"/>
                                                    </td>
                                                    <td style="border: none !important; text-align:right;">
                                                        <!-- <span t-esc="'{:.4f}'.format(usd_line['price_unit_usd'])" /> -->
                                                        <span t-esc="usd_line['price_unit_usd']" t-options='{"widget": "float", "precision": 4}'/>
                                                    </td>
                                                    <td style="border: none !important; text-align:right;">
                                                        <span t-esc="'{0:,.2f}'.format(float(usd_line['price_subtotal_usd']))" />
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="(22-total_lines) > 0">
                                                <t t-foreach="range(22-total_lines)" t-as="line">
                                                    <tr style="border: none !important;">
                                                        <td style="border: none !important;">
                                                            <span style="color:#fff;">-</span>
                                                        </td>
                                                        <td style="border: none !important;">
                                                            <span style="color:#fff;">-</span>
                                                        </td>
                                                        <td style="border: none !important;">
                                                            <span style="color:#fff;">-</span>
                                                        </td>
                                                        <td style="border: none !important;">
                                                            <span style="color:#fff;">-</span>
                                                        </td>
                                                        <td style="border: none !important;">
                                                            <span style="color:#fff;">-</span>
                                                        </td>
                                                        <td style="border: none !important;">
                                                            <span style="color:#fff;">-</span>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                    <t t-if="(22-total_lines) &lt;= 0 and (22-total_lines) &gt;= -15">
                                        <p t-attf-style="page-break-inside: avoid !important;page-break-after: always !important;" />
                                        <br />
                                        <br />
                                        <br />
                                    </t>
                                    <footer>
                                        <table class="total" width="100%" style="border: 1px solid black;">
                                            <tr>
                                                <td colspan="6" style="text-align:left; vertical-align: top; border-right: 1px solid black; width:70%;">
                                                    <div style="margin-bottom: 10px;">
                                                        <strong>Remarks:</strong>
                                                        <span t-esc="o.remarks" />
                                                    </div>
                                                    <div style="margin-top: 20px; border-top:1px solid;">
                                                        <strong>In words:</strong>
                                                        <span t-esc="convert_to_words(converted_values.get(o.id, {}).get('amount_total_usd', 0.0))" />
                                                    </div>
                                                </td>
                                                <td colspan="1" style="text-align:right; vertical-align: top; border-left: 1px solid black; padding-right: 20px;">
                                                    <div style="margin-bottom: 5px;">
                                                        <strong style="float: left; padding-left: 6px;">Sub Total</strong>
                                                        <span t-esc="'{0:,.2f}'.format(converted_values.get(o.id, {}).get('amount_untaxed_usd', 0.0))" />
                                                    </div>
                                                    <div style="margin-bottom: 5px;">
                                                        <strong style="float: left; padding-left: 6px;">GST</strong>
                                                        <span t-esc="'{0:,.2f}'.format(converted_values.get(o.id, {}).get('amount_tax_usd', 0.0))" />
                                                    </div>
                                                    <div style="margin-bottom: 5px;">
                                                        <strong style="float: left; padding-left: 6px;">Inv Total USD</strong>
                                                        <span t-esc="'{0:,.2f}'.format(converted_values.get(o.id, {}).get('amount_total_usd', 0.0))" />
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="border-top: 1px solid black; text-align:center;" colspan="7">
                                                    Best Oil Company Pvt. Ltd.
                                                    <br />
                                                    <br />
                                                    <br />
                                                    <br />
                                                    <div class="main_div_n">
                                                        <div class="left_div_n" style="text-align:left; margin-left:10px;width:28%;">
                                                            <span t-esc="o.create_uid.name" /><br />
                                                            <p style="border-top: 1px dashed black; display: inline-block; width:55%;padding-top: 0;">
                                                                Prepared By:</p>
                                                        </div>
                                                        <div class="center_div_n" style="text-align:center; margin-left:-10px;width:40%;">
                                                            <br />
                                                            <p style="border-top: 1px dashed black; display: inline-block; width:50%;padding-top: 0;">
                                                                Checked By:</p>
                                                        </div>
                                                        <div class="right_div_n" style="text-align:right; margin-right:10px;float:right !important;width:18%;">
                                                            <br />
                                                            <p style="border-top: 1px dashed black; display: inline-block; width:100%;padding-top: 0;">
                                                                Delivered By:</p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <!-- <td style="border-left: 1px solid black; border-top: 1px solid black; text-align:center;" colspan="2">
                                                    <strong>Received the items in good condition</strong><br />
                                                    <br />
                                                    <br />
                                                    <p style="margin-top:8px;width: 90%;border-top: 1px dashed black; display: inline-block; padding-top: 0;">
                                                        Received By: Name, Date &amp; Signature
                                                    </p>
                                                </td> -->
                                            </tr>
                                            <tr>
                                                <td style="border-top: 1px solid black;  border-right: 1px solid black;" colspan="7">
                                                    <span style="text-align:center; font-size:13px; margin: 5px 0;" t-esc="o.note" />
                                                </td>
                                            </tr>
                                        </table>
                                    </footer>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>