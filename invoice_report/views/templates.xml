         <record id="invoice_report_ext" model="ir.actions.report">
            <field name="name">Invoice</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">invoice_report.invoice_report</field>
            <field name="report_file">invoice_report.invoice_report</field>
            <field name="print_report_name">'Invoice - %s' %(object.name)</field>
            <field name="binding_model_id" ref="account.model_account_move" />
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="invoice_report_format" />
        </record>
        <!-- print_report_name="'%s  %(object.name)"  -->
      <template id="report_invoice_document_ext" inherit_id="account.report_invoice_document">              
            <xpath expr="//div[hasclass('page')]" position="before">
                 <h2 style='color:black;font-size: 2rem;margin-bottom: 0px !important;text-transform: capitalize !important;'>Tax Invoice </h2>
            </xpath>
        </template>
