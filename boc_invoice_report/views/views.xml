                                </style>
                                <div class="main_wraper">
                                    <br style="clear:both; float:none;border:none; width:0;height:0;" />
                                    <div class="main_div_n">
                                    </div>
                                    <div class="left_div_n">
                                        <!-- 12175 -->
                                        <span t-esc="o.partner_id.customer_rank" />
                                    </div>
                                    <div class="center_div_n">
                                        <strong style="font-size: 16px;">1020992GST501</strong>
                                    </div>
                                    <div class="right_div_n" style="border: 1px solid black; padding-left: 1px; text-align: center; margin-bottom: 5px;">
                                        <strong style="font-size: 18px;">TAX INVOICE</strong>
                                    </div>
                                    <br style="clear:both; float:none;border:none; width:0;height:0;" />
                                    <div class="main_div">
                                        <div class="left_div_1">
                                            <table class="box-table">
                                                <tr>
                                                    <td style="padding-left :2px;">
                                                        <span t-esc="o.partner_id.name" /><br />
                                                        <span t-esc="o.partner_id.street" />
                                                        <span t-esc="o.partner_id.street2" />
                                                        <span t-esc="o.partner_id.state_id.name" />
                                                        <span t-esc="o.partner_id.zip" />
                                                        <span t-esc="o.partner_id.country_id.name" />
                                                        TIN:<span t-esc="o.partner_id.vat" />
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="right_div_1">
                                            <table class="box-table-new">
                                                <tr>
                                                    <td class="left-column">
                                                        <div><strong>Purchase Order:</strong>
                                                            <span t-esc="o.ref" />
                                                        </div>
                                                        <div><strong>Delivery Order Ref:</strong> <span t-esc="delivery_orders.get(o.id, 'N/A')" /></div>
                                                        <div><strong>Terms:</strong>
                                                            <span t-esc="o.invoice_payment_term_id.name" />
                                                        </div>
                                                    </td>
                                                    <td class="right-column">
