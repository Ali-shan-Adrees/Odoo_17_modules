                                                        <span t-esc="'{0:,.2f}'.format(float(line.quantity))"/>
                                                    </td>
                                                    <td style="text-align: right;">
                                                        <span t-esc="line.product_id.default_code" />
                                                    </td>
                                                    <td style="text-align:left;">
                                                        <span t-esc="line.product_id.name" />
                                                    </td>
                                                    <td style="text-align: right;">
                                                        <!-- <span t-esc="float(usd_line['price_unit_usd'])" /> -->
                                                        <span t-esc="usd_line['price_unit_usd']" t-options='{"widget": "float", "precision": 4}'/>
                                                    </td>
                                                    <td>
                                                        <span t-esc="line.product_uom_id.name" />
                                                    </td>
                                                    <td style="text-align: right;">
                                                        <span t-esc="float(usd_line['price_subtotal_usd'])" />
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-foreach="range(24-total_lines)" t-as="line">
                                                <tr>
                                                    <td><span style="color:#fff;">-</span></td>
                                                    <td><span style="color:#fff;">-</span></td>
                                                    <td><span style="color:#fff;">-</span></td>
                                                    <td><span style="color:#fff;">-</span></td>
                                                    <td><span style="color:#fff;">-</span></td>
                                                    <td><span style="color:#fff;">-</span></td>
                                                    <td><span style="color:#fff;">-</span></td>
                                                    <td><span style="color:#fff;">-</span></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                    <t t-if="(18-total_lines) &lt;= 0 and (18-total_lines) &gt;= -15">
                                        <p t-attf-style="page-break-inside: avoid !important;page-break-after: always !important;" />
                                    </t>
                                    <table class="table_total_cn" style="width:100%;">
                                        <tr style="border:none;">
                                            <td style="padding:10px;border:none;width:41%"><b>Comments:</b></td>
                                            <td style="padding:10px;border:none;border-right:1px solid #000;width:20%"><b>Tax summary:</b></td>
                                            <td style="padding:10px;border:none;border-right:1px solid #000;"><b>Subtotal</b></td>
                                            <td style="text-align:right;padding:10px;border:none;border-right:1px solid #000;">
                                                <b><span t-esc="float(converted_values[o.id]['amount_untaxed_usd'])" /> </b>
                                            </td>
                                        </tr>
                                        <tr style="border:none;">
                                            <td style="padding:10px;border:none;width:41%">
                                                <span t-field="o.ref"></span>
                                            </td>
                                            <td style="padding:10px;border:none;border-right:1px solid #000;width:30%">
                                                <t t-set="tax_totals" t-value="o.tax_totals" />
