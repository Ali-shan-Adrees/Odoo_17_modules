                                                <td style="border-right:1px solid #000 !important;border: none;text-align:center;"><span t-esc="o.invoice_user_id.name" /></td>
                                                <td style="border-right:1px solid #000 !important;border: none;text-align:center;"> <span t-esc="data['sale_order']" /></td>
                                                <td style="border-right:1px solid #000 !important;border: none;text-align:center;"> <span t-esc="data.get('order_date') and data['order_date'] or ''" /></td>
                                                <td style="border-right:1px solid #000 !important;border: none;text-align:center;"><span t-esc="o.customer_po" /></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <br />
