                                    border-collapse: collapse;
                                }

                                .center_div_cn {
                                    width: 20%;
                                    float: left;
                                }

                                .main_wraper_cn {
                                    width: 100%;
                                }

                                .main_div_cn {
                                    width: 100%;
                                }

                                .left_div_cn {
                                    width: 40%;
                                    float: left;
                                }

                                .center_div_cn {
                                    width: 20%;
                                    float: left;
                                }

                                .right_div_cn {
                                    float: right;
                                    width: 30%;
                                }

