                                                                    <span class="text-nowrap" t-out="float(amount_by_group['tax_group_amount'])" />
                                                                </span>
                                                            </div>
                                                            <br class="clear_float" />
                                                        </t>
                                                    </t>
                                                </t>
                                            </td>
                                            <td style="width:15.5%;padding:10px;border:none;border-right:1px solid #000;"><b>Total sales tax</b></td>
                                            <td style="text-align:right;padding:10px;border:none;border-right:1px solid #000;">
                                                <b><span t-esc="float(converted_values[o.id]['amount_tax_usd'])" /> </b>
                                            </td>
                                        </tr>
                                        <tr style="border:none;">
                                            <td style="padding:10px;border:none;width:41%" />
                                            <td style="padding:10px;border:none;border-right:1px solid #000;width:30%" />
                                            <td style="width:15.5%;padding:10px;border:1px solid #000;"><b>Total Credit USD</b></td>
                                            <td style="text-align:right;padding:10px;border:1px solid #000;">
                                                <b><span t-esc="float(converted_values[o.id]['amount_total_usd'])" /></b>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </t>
                            <t t-if="o.move_type == 'out_invoice'">
