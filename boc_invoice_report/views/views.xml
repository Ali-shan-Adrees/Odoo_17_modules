                                        <tr style="vertical-align:baseline;">
                                            <td style="width:15%;padding:10px 10px;border-right:none !important;"><strong> <span>Credit the account of:</span></strong> <br /></td>
                                            <td style="padding:10px 10px;border-left: none !important; padding-bottom: 5px;">
                                                <span t-esc="o.partner_id.name">
                                                </span>
                                                <span t-esc="o.partner_id.street" />
                                                <span t-esc="o.partner_id.street2" />
                                                <span t-esc="o.partner_id.state_id.name" />
                                                <span t-esc="o.partner_id.zip" />
                                                <span t-esc="o.partner_id.country_id.name" />
                                                <span t-esc="o.partner_id.street2" /><br />
                                                TIN:<span t-esc="o.partner_id.vat" />
                                            </td>
                                        </tr>
                                    </table>
                                    <br />
                                    <table class="table_new_cn" width="100%" style="margin-top: 2px; ">
