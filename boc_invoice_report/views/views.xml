                                            </t>
                                        </thead>
                                        <tbody style="border: none;">
                                            <tr style="border-top: none !important">
                                                <td style="border-right:1px solid #000 !important;border: none;text-align:center;"><span t-esc="data['related_invoice']" /></td>
                                                <td style="border-right:1px solid #000 !important;border: none;text-align:center; border-left: 1px solid black;"> <span t-if="data.get('related_invoice')" t-esc="invoice_date" />
                                                    <span t-if="not data.get('related_invoice')"></span></td>
