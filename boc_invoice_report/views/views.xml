                                                    <th style="text-align:left; ">Unit Price</th>
                                                    <th style="text-align:left; ">Net amount</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-set="total_lines" t-value="len(o.invoice_line_ids)" />
                                                <t t-foreach="o.invoice_line_ids" t-as="line">
                                                    <t t-set="usd_line" t-value="line_converted_values[o.id][line.id]" />
                                                    <tr style="border: none !important;">
                                                        <td style="border: none !important; text-align: right;">
                                                            <span t-esc="line.product_id.default_code" />
                                                        </td>
                                                        <td style="border: none !important;">
                                                            <span t-esc="line.name.replace('[%s] ' % line.product_id.default_code if line.product_id.default_code else '', '')"/>
                                                        </td>
                                                        <td style="border: none !important; text-align:center;">
                                                            <span t-esc="line.product_uom_id.name" />
                                                        </td>
                                                        <td style="border: none !important; text-align: right;">
                                                            <span t-esc="'{0:,.2f}'.format(float(line.quantity))"/>
