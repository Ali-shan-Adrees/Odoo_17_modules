                                                <th style="text-align:center; border-left: 1px solid black;padding-right:5px;padding-left:5px;padding-top:5px; padding-bottom:5px;">
                                                    UOM
                                                </th>
                                                <th style="text-align:center; border-left: 1px solid black; padding-right:5px; padding-left:5px; padding-top:5px; padding-bottom:5px;">Extended Price</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="total_lines" t-value="len(o.invoice_line_ids)" />
