        <record id="card_printing_report_id" model="ir.actions.report">
            <field name="name">Card Printing Report</field>
            <field name="model">card.printing.report</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">card_printing_report.card_printing_report</field>
            <field name="report_file">card_printing_report.card_printing_report</field>
            <field name="print_report_name">Card Printing Report</field>
            <field name="attachment"/>
            <field name="binding_model_id" ref="card_printing_report.model_card_printing_report"/>
            <field name="binding_type">report</field>
        </record>

        <record id="card_printing_report_action" model="ir.ui.view">
            <field name="name">card_printing_report_action</field>
            <field name="model">card.printing.report</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Report">
                        
                    <group name="group_top">
                        <group name="group_right">
                          
                            <field name="product_id"  options="{'no_open':True,'no_create': True}"  domain="[('stage','=','utilization')]" readonly="1" force_save="1"/>
                            <!-- widget="many2many_tags" -->
                        </group>

                    </group>
                    
                        <footer style="height: 30px !important; border: none !important;">
                            <button name="generate_report" type="object" string="Print" class = "oe_highlight" />
                        </footer>

                </form>
            </field>
        </record>

        <!-- <record id="security_group_for_sub_agent_report" model="res.groups">
            <field name="name">Security Group For sub_agent_report</field>
        </record> -->

        <record id="card_printing_report_action_menu" model="ir.actions.act_window">
            <field name="name">Printing Card Report</field>
            <field name="res_model">card.printing.report</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="card_printing_report_action"/>
            <field name="target">new</field>
        </record>
