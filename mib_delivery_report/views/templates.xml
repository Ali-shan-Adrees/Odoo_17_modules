         <record id="mib_delivery_report_pap_ext" model="ir.actions.report">
            <field name="name">Delivery MIB</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">mib_delivery_report.mib_delivery_report</field>
            <field name="report_file">mib_delivery_report.mib_delivery_report</field>
            <field name="print_report_name">'Delivery Slip - %s - %s' % (object.partner_id.name or '', object.name)</field>
            <field name="binding_model_id" ref="stock.model_stock_picking" />
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="mib_delivery_report_pap" />
        </record>
    </data>
